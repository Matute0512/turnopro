# Copiar este archivo a .env y completar los valores.
# .env esta en .gitignore: nunca versionar credenciales reales.

# Variables usadas por docker-compose.yml (servicio db)
POSTGRES_USER=admin
POSTGRES_PASSWORD=pon_aqui_tu_password_local
POSTGRES_DB=turnopro_db

# Connection string que usa el backend (servicio web)
DATABASE_URL="postgresql+asyncpg://usuario_admin:pon_aqui_tu_password_local@localhost:5432/turnopro"
